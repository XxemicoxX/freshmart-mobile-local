# MODO DEMO (por defecto): la app funciona sin servidor, con datos locales. No necesitas configurar nada.
# Para usar el backend real: EXPO_PUBLIC_MODO_DEMO=false y define la URL.
EXPO_PUBLIC_MODO_DEMO=true
# Emulador Android: 10.0.2.2 apunta al localhost de tu PC. En celular físico usa la IP de tu PC.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1
